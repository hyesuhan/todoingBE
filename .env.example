# DB (docker-compose.yml의 postgres 서비스 기준)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/todoing
DB_USERNAME=todoing
DB_PASSWORD=todoing

# JWT
JWT_SECRET=
JWT_ACCESS_EXPIRE=3600000
JWT_REFRESH_EXPIRE=1209600000

# OpenAI (Spring AI)
OPENAI_API_KEY=

# Kakao Login
KAKAO_CLIENT_ID=
KAKAO_REDIRECT_URI=http://localhost:8080/api/users/login/kakao

# Kakao Pay
KAKAOPAY_CID=
KAKAOPAY_SECRET_KEY=

# Google Cloud Vision / Speech (google-cloud-vision, google-cloud-speech)
# 서비스 계정 JSON 키 파일 경로 (Application Default Credentials)
GOOGLE_APPLICATION_CREDENTIALS=
